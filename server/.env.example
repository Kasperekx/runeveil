# Docker Compose defaults — copy this file to server/.env for local development.
DATABASE_URL=postgresql://mmo:mmo@localhost:5432/mmo
DATABASE_POOL_SIZE=12
# PGSSLMODE=require
PORT=2567
CLIENT_ORIGIN=http://localhost:8080
# Set to 1 only when the server is behind a trusted reverse proxy.
TRUST_PROXY=0
NODE_ENV=development
